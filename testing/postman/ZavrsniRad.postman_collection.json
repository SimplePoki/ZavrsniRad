{
    "info": {
        "name": "ZavrsniRad API",
        "description": "PHP REST API za evidenciju njege u domu za starije - lokalno testiranje preko PHP dev servera (php -S localhost:8000 -t api).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"{{testEmail}}\",\n    \"lozinka\": \"{{testLozinka}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "login.php"]
                        }
                    }
                },
                {
                    "name": "Tko sam ulogiran (me)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/me.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "me.php"]
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["auth", "logout.php"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Umirovljenici",
            "item": [
                {
                    "name": "Lista",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/umirovljenici/index.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["umirovljenici", "index.php"]
                        }
                    }
                },
                {
                    "name": "Dodaj",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"ime\": \"Test\",\n    \"prezime\": \"Testić\",\n    \"lokacija_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/umirovljenici/index.php",
                            "host": ["{{baseUrl}}"],
                            "path": ["umirovljenici", "index.php"]
                        }
                    }
                },
                {
                    "name": "Pojedinačno",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/umirovljenici/item.php?id={{umirovljenikId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["umirovljenici", "item.php"],
                            "query": [{ "key": "id", "value": "{{umirovljenikId}}" }]
                        }
                    }
                },
                {
                    "name": "Uredi",
                    "request": {
                        "method": "PUT",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"ime\": \"Test\",\n    \"prezime\": \"Izmijenjeno\",\n    \"lokacija_id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/umirovljenici/item.php?id={{umirovljenikId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["umirovljenici", "item.php"],
                            "query": [{ "key": "id", "value": "{{umirovljenikId}}" }]
                        }
                    }
                },
                {
                    "name": "Obriši (deaktiviraj)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/umirovljenici/item.php?id={{umirovljenikId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["umirovljenici", "item.php"],
                            "query": [{ "key": "id", "value": "{{umirovljenikId}}" }]
                        }
                    }
                }
            ]
        },
